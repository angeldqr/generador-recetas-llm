DATABASE_URL=mysql+pymysql://recetas_user:recetas_password@db:3306/generador-recetas-llm-db
SECRET_KEY=change-this-secret-key-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter: create a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# MySQL Docker service
MYSQL_DATABASE=generador-recetas-llm-db
MYSQL_USER=recetas_user
MYSQL_PASSWORD=recetas_password
MYSQL_ROOT_PASSWORD=root_password_change_me
