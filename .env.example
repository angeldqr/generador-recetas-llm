# ============================================
# Generador de Recetas LLM — Variables de Entorno
# ============================================

# Base de datos (PostgreSQL en Docker)
DATABASE_URL=postgresql+psycopg2://recetas_user:recetas_password_dev@db:5432/generador-recetas-llm-db

# PostgreSQL Docker config
POSTGRES_DB=generador-recetas-llm-db
POSTGRES_USER=recetas_user
POSTGRES_PASSWORD=recetas_password_dev

# Seguridad JWT
SECRET_KEY=cambia_esta_clave_por_una_muy_segura_de_32_caracteres_minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter LLM
OPENROUTER_API_KEY=sk-or-v1-tu_api_key_aqui
OPENROUTER_MODEL=openai/gpt-4o-mini

# Frontend (solo desarrollo local)
VITE_API_BASE_URL=http://localhost:8000
